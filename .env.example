# CockroachDB Cloud
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full
COCKROACH_CLUSTER_ID=
# Optional: used by the Managed MCP memory-auditor workflow.
COCKROACH_MCP_API_KEY=

# AWS hosted runtime
AWS_REGION=ap-northeast-1
DEMO_API_TOKEN=
# JSON object keyed by SHA-256 digests of opaque per-agent tokens. The raw
# tokens are never stored in Lambda configuration. Each grant binds an agent
# identity to scope prefixes, permissions, and optional server-side trust.
AGENT_AUTH_JSON={}
# Optional server-side trust registry for conflict resolution. Never supplied by
# the producer itself; values are deployment policy in the range 0..1.
AGENT_TRUST_JSON={}

# NVIDIA bounded explanation provider
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=meta/llama-3.1-8b-instruct
NVIDIA_EMBED_MODEL_ID=nvidia/nv-embedqa-e5-v5
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional Bedrock provider seam; not required by the frozen competition path.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
