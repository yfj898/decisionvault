# CockroachDB Cloud
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=8000
READINESS_CACHE_SECONDS=30
SECRET_REFRESH_SECONDS=30
SECURITY_RECONCILE_SECONDS=30
AGENT_RATE_LIMIT_PER_MINUTE=60
DEMO_RATE_LIMIT_PER_MINUTE=10

# Hosted Lambda: store sensitive runtime values in one AWS Secrets Manager JSON
# object and set only its ARN on the function. Direct values below remain useful
# for local development and smoke tests.
DECISIONVAULT_SECRET_ARN=
COCKROACH_CLUSTER_ID=
# Optional: used by the Managed MCP memory-auditor workflow.
COCKROACH_MCP_API_KEY=

# AWS hosted runtime
AWS_REGION=ap-northeast-1
DEMO_API_TOKEN=
# JSON object keyed by SHA-256 digests of opaque per-agent tokens. The raw
# tokens are never stored in Lambda configuration. Each grant binds an agent
# identity to namespace-bounded scopes, permissions, and optional server-side trust.
AGENT_AUTH_JSON={}
# Non-sensitive second authorization boundary for producer-bound /revoke.
# Values are server-bound agent IDs, never raw agent tokens.
REVOKE_AGENT_IDS=
EXECUTION_RECEIPT_SECRET=
EXECUTION_SANDBOX_SCENARIO=stale_payment_token
# Non-sensitive server-owned outcome fixture for the hackathon execution sandbox.
# General /execute callers cannot supply or override this scenario.
EXECUTION_SANDBOX_SCENARIO=stale_payment_token

# NVIDIA bounded explanation provider
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=meta/llama-3.1-8b-instruct
NVIDIA_EMBED_MODEL_ID=nvidia/nv-embedqa-e5-v5
# Operator-owned embedding generation. Bump this before re-embedding whenever
# the provider/model generation changes; different revisions never mix recall.
NVIDIA_EMBED_REVISION=decisionvault-prod-r1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=20

# Optional Bedrock provider seam; not required by the frozen competition path.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
